// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  password  String

  expenses  Expense[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  category    String
  expenseDate TimestamptzString @default(now())

  user        User     @relation(fields: [userId], references: [id])
  userId      Int

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}
